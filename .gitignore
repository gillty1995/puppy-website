# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignore everything in uploads
/public/uploads/*
# except the .gitkeep so folder stays in repo
!/public/uploads/.gitkeep

# ignore all committed posts data
/src/data/posts.json
/src/data/commentLeads.json
/exports/

# ignore scripts folder
/scripts/# toolchain/binaries accidentally added
x86_64-linux-gnu*
libunwind*
*.1.gz
*.gz
qemu
setarch
objcopy*
objdump*
nm.1.gz

# Build output
/dist

# PID files
*.pid

# VSCode
.vscode/

# runtime / auxiliary files
dump.rdb                 
worker.log              
*.log                    
.env.local.local         
.eslintcache             
.cache/                  
/.vercel/build-cache     
npm-debug.log*           
*.tgz                    

next.config.js
next.config.cjs
